{
  "redirects": [
    { "source": "/", "destination": "/techpartner/", "permanent": false },
    { "source": "/index.html", "destination": "/techpartner/", "permanent": false },
    { "source": "/:page(services|products).html", "destination": "/techpartner/:page.html", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)\\.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)/js/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.min\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(webp|png|mp4)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] }
  ]
}
